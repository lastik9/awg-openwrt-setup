# =====================================================================
#  awg.env  —  параметры туннеля AmneziaWG для setup-awg.sh
#  Скопируй в awg.env и заполни значениями из своего .conf
#  Значения бери БЕЗ кавычек в .conf, но здесь оборачивай в '...'
# =====================================================================

# --- имя интерфейса (обычно не меняем) ---
IFACE='awg0'

# --- [Interface] ---
PRIVATE_KEY='вставь_приватный_ключ'
ADDRESSES='10.0.0.2/32'   # поле Address, через запятую
DNS='94.140.14.14,94.140.15.15'                    # необязательно, можно оставить пустым ''
MTU='1280'

# --- obfuscation ([Interface]) ---
# Пусто = параметр не задаём (возьмётся дефолт драйвера).
JC='4'
JMIN='40'
JMAX='70'
S1='0'
S2='0'
S3='0'      # для AWG 2.0; для 1.5 оставь как в конфиге
S4='0'
H1='1'
H2='2'
H3='3'
H4='4'
# I1 — огромный hex-блоб. Вставляй ОДНОЙ строкой целиком, включая '<b 0x...>'
I1='<b 0x...>'

# --- [Peer] ---
PEER_PUBLIC_KEY='публичный_ключ_сервера'
PRESHARED_KEY=''                    # пусто если не используется
ENDPOINT_HOST='SERVER_IP_OR_HOST'
ENDPOINT_PORT='51820'
ALLOWED_IPS='0.0.0.0/0,::/0'
PERSISTENT_KEEPALIVE='25'

# --- firewall-зона ---
CREATE_ZONE='1'        # 1 = создать зону; 0 = не трогать фаервол
ZONE_NAME='awg'
